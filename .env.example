# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed - it's the only place a real API key belongs.

# Which LLMProvider `fetch` uses (internal/llmprovider). Defaults to "fake"
# (no network calls, deterministic sample data) when unset.
LLM_PROVIDER=claude

# Required when LLM_PROVIDER=claude. Get one from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: overrides internal/llmprovider/claude.DefaultModel (claude-opus-5).
ANTHROPIC_MODEL=
